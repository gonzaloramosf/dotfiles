{
  "global_lsp_settings": {
    "button": false
  },
  "git_panel": {
    "default_width": 360.0,
    "show_count_badge": false,
    "status_style": "icon",
    "dock": "right"
  },
  "outline_panel": {
    "file_icons": true,
    "button": false
  },
  "bottom_dock_layout": "contained",
  "debugger": {
    "dock": "bottom",
    "button": true,
  },
  "search": {
    "button": false,
  },
  "status_bar": {
    "show_active_file": true,
    "line_endings_button": false,
    "cursor_position_button": true,
    "active_language_button": true,
  },
  "close_on_file_delete": true,
  "diagnostics": {
    "button": false,
    "inline": {
      "enabled": false,
    },
  },
  "document_symbols": "off",
  "semantic_tokens": "off",
  "colorize_brackets": false,
  "code_lens": "on",
  "inlay_hints": {
    "show_other_hints": false,
    "show_parameter_hints": false,
    "show_type_hints": false,
    "show_value_hints": false,
    "enabled": false,
  },
  "show_whitespaces": "selection",
  "format_on_save": "on",
  "indent_guides": {
    "background_coloring": "disabled",
  },
  "gutter": {
    "bookmarks": false,
  },
  "relative_line_numbers": "disabled",
  "drag_and_drop_selection": {
    "enabled": false,
  },
  "hover_popover_delay": 100,
  "git": {
    "blame": {
      "show_avatar": false
    },
    "inline_blame": {
      "location": "status_bar",
      "show_commit_summary": true,
    },
  },
  "minimap": {
    "thumb_border": "none",
  },
  "scrollbar": {
    "show": "auto",
  },
  "terminal": {
    "scrollbar": {
      "show": "auto",
    },
  },
  "preview_tabs": {
    "enabled": true,
  },
  "tabs": {
    "show_close_button": "hidden",
    "show_diagnostics": "off",
    "activate_on_close": "history",
    "close_position": "right",
    "file_icons": false,
    "git_status": true,
  },
  "title_bar": {
    "show_menus": false,
    "show_user_picture": false,
    "show_user_menu": false,
    "show_onboarding_banner": false,
    "show_project_items": true,
    "show_branch_status_icon": true,
    "show_sign_in": false,
  },
  "collaboration_panel": {
    "button": false,
  },
  "project_panel": {
    "hide_root": false,
    "bold_folder_labels": false,
    "auto_fold_dirs": true,
    "folder_indicator": "icon",
    "file_icons": true,
    "button": true,
    "entry_spacing": "standard",
    "default_width": 250.0,
    "diagnostic_badges": true,
    "git_status_indicator": true,
    "scrollbar": {
      "show": "auto",
    },
    "dock": "right",
  },
  "show_edit_predictions": false,
  "lsp_results_location": "picker",
  "agent": {
    "flexible": false,
    "button": false,
    "favorite_models": [],
    "model_parameters": [],
    "enable_feedback": false,
  },
  "disable_ai": true,
  "proxy": "",
  "autosave": "off",
  "ui_font_family": "SF Pro",
  "buffer_font_family": "SF Mono",
  "auto_update": false,
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
    "anthropic_retention": false,
  },
  "session": {
    "trust_all_worktrees": false,
  },
  "base_keymap": "JetBrains",
  "icon_theme": "Zed (Default)",
  "ui_font_size": 17.0,
  "buffer_font_size": 15.0,
  "theme": "macOS Classic Light",
  "tab_bar": {
    "show_pinned_tabs_in_separate_row": false,
    "show": true,
    "show_nav_history_buttons": false,
    "show_tab_bar_buttons": false,
  },
  "toolbar": {
    "breadcrumbs": false,
    "quick_actions": false,
    "selections_menu": false,
    "agent_review": false,
    "code_actions": false,
  },
