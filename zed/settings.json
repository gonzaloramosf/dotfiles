{
  "project_panel": {
    "dock": "left"
  },
  "diff_view_style": "split",
  "disable_ai": true,
  "title_bar": {
    "show_sign_in": false
  },
  "agent": {
    "button": false
  },
  "collaboration_panel": {
    "button": false
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
    "anthropic_retention": false
  },
  "vim_mode": false,
  "agent_servers": {
    "codex-acp": {
      "type": "registry"
    }
  },
  "base_keymap": "JetBrains",
  "auto_install_extensions": {
    "jetbrains-icons": true
  },
  "icon_theme": {
    "mode": "dark",
    "light": "JetBrains Icons Light",
    "dark": "JetBrains Icons Dark"
  },
  "ui_font_family": ".SystemUIFont",
  "ui_font_size": 18,
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "buffer_font_size": 15,
  "theme": {
    "mode": "dark",
    "light": "Ayu Light",
    "dark": "One Dark",
  },
}
